10 REM RAIN - 4 PM SPRITES CASCADE DOWN, ALIGNED TO GR1 COLUMNS
15 PMBPG=(INT(PEEK(106)/8)-1)*8 : POKE 106,PMBPG : PMGBASE=PMBPG*256
20 GRAPHICS 0
25 POKE 559,62          : REM DMACTL - ENABLE SINGLE-LINE PM DMA
30 SETCOLOR 4,0,0       : REM BLACK BACKGROUND
45 MSA = 1688           : REM PAGE 6 MEMSET ENTRY POINT
55 OPEN #1,4,0,"H1:UTIL.BIN"
56 BGET #1,$0600,210
57 CLOSE #1
60 REM FOR I=0 TO 1023:POKE PMGBASE+1024+I,0:NEXT I : REM CLEAR PLAYER AREA
61 X=USR(MSA,PMGBASE+1024,1024,0) : REM ML MEMSET (SWAP WITH LINE 60)
70 POKE 54279,PMBPG     : REM PMBASE REGISTER
80 POKE 53277,3         : REM GRACTL - PLAYERS AND MISSILES ON
90 POKE 623,1           : REM PRIOR - SPRITES FLOAT OVER PLAYFIELD
100 POKE 53256,0:POKE 53257,0:POKE 53258,0:POKE 53259,0 : REM NORMAL WIDTHS
110 POKE 704,148:POKE 705,70:POKE 706,40:POKE 707,14    : REM SPRITE COLORS
120 VA = 1792            : REM PAGE 7 ($0700) - VBI ROUTINE GOES HERE
130 REM VBI TABLE LAYOUT (END OF PAGE 7, ABOVE 85-BYTE VBI CODE):
140 REM VA+232 ($07E8): ZONE_BASE[0..3] - LEFTMOST HPOSP OF EACH SPRITE ZONE
150 REM VA+240 ($07F0): XPOS[0..3]      - CURRENT HPOS OF EACH SPRITE
160 REM VA+244 ($07F4): YPOS[0..3]      - CURRENT SCANLINE OF EACH SPRITE
170 REM GR1: 20 COLS, 8PX WIDE. HPOSP=48+COL*8. ZONES GUARANTEE NO CONFLICTS.
180 POKE VA+232,48:POKE VA+233,88:POKE VA+234,128:POKE VA+235,168
190 POKE VA+240,48:POKE VA+241,88:POKE VA+242,128:POKE VA+243,168
200 POKE VA+244,16:POKE VA+245,64:POKE VA+246,112:POKE VA+247,160
210 POKE 53248,48:POKE 53249,88:POKE 53250,128:POKE 53251,168
220 REM DRAW INITIAL 8-PIXEL SPRITES IN PM BUFFER BEFORE VBI STARTS
230 FOR P=0 TO 3
240 PB = PMGBASE+1024+P*256
250 YP = PEEK(VA+244+P)
260 FOR Y=0 TO 7:POKE PB+YP+Y,255:NEXT Y
270 NEXT P
280 REM LOAD VBI ROUTINE FROM BINARY FILE INTO PAGE 7
290 OPEN #1,4,0,"H1:RAIN.BIN"
295 BGET #1,$0700,85
297 CLOSE #1
298 POKE VA+5,PMBPG+4   : REM PATCH VBI: PM PLAYER PAGE BASE = PMBASE+4 PAGES
300 REM INSTALL DEFERRED VBI: VVBLKD VECTOR AT $0224/$0225
310 POKE 548,0:POKE 549,7
320 REM GOTO 320
